 def start_daemon() -> str:
     """Start the recorder: through its systemd user unit if installed, else detached."""
+    if os.path.exists("/.flatpak-info"):
+        # A child of this sandbox would be killed when the overlay exits (the
+        # sandbox ends with its first process). flatpak-spawn asks the Flatpak
+        # portal for a new, independent instance of this app instead.
+        subprocess.Popen(["flatpak-spawn", "momento", "daemon"],
+                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                         start_new_session=True, close_fds=True)
+        return "flatpak"
