 from pathlib import Path
 
@@ -83,6 +84,17 @@ def main(argv: list[str] | None = None) -> int:
     if args.command == "overlay":
         from . import overlay
 
+        # Flatpak: each `flatpak run` has its own PID namespace, so the pidfile
+        # toggle can't see a bar the daemon opened. Let the daemon open/close
+        # it; fall back to running it here when no daemon is up.
+        if os.path.exists("/.flatpak-info"):
+            from . import ipc
+
+            try:
+                if ipc.request({"cmd": "overlay"}, timeout=5).get("ok"):
+                    return 0
+            except (ipc.IPCError, OSError, ValueError):
+                pass
         return overlay.main([]) or 0
 
     if args.command == "daemon":
diff --git a/momento/config.py b/momento/config.py
index fd6955c..a28d73b 100644
--- a/momento/config.py
+++ b/momento/config.py
@@ -16,6 +16,12 @@ CONFIG_DIR = _xdg("XDG_CONFIG_HOME", ".config") / "momento"
 CACHE_DIR = _xdg("XDG_CACHE_HOME", ".cache") / "momento"
 STATE_DIR = _xdg("XDG_STATE_HOME", ".local/state") / "momento"
 RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/momento-{os.getuid()}")
+# Flatpak gives every `flatpak run` its own private XDG_RUNTIME_DIR; only
+# $XDG_RUNTIME_DIR/app/$FLATPAK_ID is shared between instances of the app. The
+# socket and overlay pidfile must live there or `flatpak run ... save 30s`
+# could never reach the daemon.
+if os.environ.get("FLATPAK_ID") and os.environ.get("XDG_RUNTIME_DIR"):
+    RUNTIME_DIR = RUNTIME_DIR / "app" / os.environ["FLATPAK_ID"]
 SOCKET_PATH = RUNTIME_DIR / "momento.sock"
 
 
